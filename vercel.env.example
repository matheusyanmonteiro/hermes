# Hermes na Vercel Services
#
# Preencha os valores marcados com SUBSTITUA antes de importar em:
# Vercel > hermes > Settings > Environment Variables.
# Aplique inicialmente ao ambiente Production. Depois repita para Preview,
# caso os deploys de Preview também precisem acessar o banco real.

# Banco: use o Transaction pooler do Supabase (normalmente porta 6543).
# A senha precisa estar codificada para URL caso contenha @, :, /, #, ? ou %.
# Visibilidade na Vercel: Secret.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA_URL_ENCODED@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# Autenticação própria do Hermes.
# AUTH_SECRET: gere com o comando indicado no fim deste arquivo.
# Visibilidade: AUTH_SECRET como Secret; AUTH_MODE como Config.
AUTH_MODE=local
AUTH_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES

# Domínio estável de produção do projeto Vercel Services.
# WEB_URL e API_URL recebem exatamente o mesmo domínio e não levam barra final.
# Visibilidade: Config.
WEB_URL=https://SUBSTITUA-PELO-DOMINIO.vercel.app
API_URL=https://SUBSTITUA-PELO-DOMINIO.vercel.app

# Valores incorporados ao frontend. Obrigatoriamente use visibilidade Config,
# nunca Secret, porque variáveis NEXT_PUBLIC_* são públicas no navegador.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_AUTH_MODE=local

# Proteção das credenciais Google Drive armazenadas no PostgreSQL.
# Gere valores diferentes para cada variável. Visibilidade: Secret.
TOKEN_ENCRYPTION_KEY=SUBSTITUA_POR_32_BYTES_EM_BASE64
OAUTH_STATE_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES

# Configuração operacional. Visibilidade: Config.
PORTAL_TIMEZONE=America/Sao_Paulo
UPLOAD_CHUNK_SIZE_BYTES=8388608
UPLOAD_CONCURRENCY=2
DOWNLOAD_CONCURRENCY=3

# Gere TOKEN_ENCRYPTION_KEY:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#
# Execute duas vezes e use saídas diferentes em AUTH_SECRET e OAUTH_STATE_SECRET:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
#
# Não adicione à Vercel:
# DIRECT_URL, BOOTSTRAP_ADMIN_*, DEV_AUTH_SECRET, DEV_LOGIN_PASSWORD,
# POSTGRES_*, SUPABASE_* ou NEXT_PUBLIC_SUPABASE_*.
