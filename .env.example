# Banco local (fora do Docker use localhost; dentro do Compose, o serviço recebe db)
POSTGRES_DB=hermes
POSTGRES_USER=hermes
POSTGRES_PASSWORD=hermes_local_change_me
DATABASE_URL=postgresql://hermes:hermes_local_change_me@localhost:5432/hermes?schema=public
# Conexão direta usada somente por migrations/bootstrap em ambientes Supabase
DIRECT_URL=

# URLs das aplicações
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=/api/v1

# Autenticação: "development" no Docker local; "local" em produção
AUTH_MODE=development
DEV_AUTH_SECRET=troque-esta-chave-local-por-uma-frase-com-32-caracteres
DEV_LOGIN_PASSWORD=hermes-dev
NEXT_PUBLIC_AUTH_MODE=development
AUTH_SECRET=

# Primeiro administrador de produção (usado somente por `pnpm db:bootstrap`)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Google OAuth / Drive (credenciais cadastradas pela tela Contas Drive)
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

# Configuração operacional
PORTAL_TIMEZONE=America/Sao_Paulo
UPLOAD_CHUNK_SIZE_BYTES=8388608
UPLOAD_CONCURRENCY=2
DOWNLOAD_CONCURRENCY=3

