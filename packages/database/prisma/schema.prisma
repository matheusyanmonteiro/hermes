generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  INVITED
}

enum DriveAccountStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING
}

enum TransferType {
  UPLOAD
  DOWNLOAD
}

enum TransferStatus {
  PENDING
  REQUESTED
  AUTHORIZED
  STARTED
  IN_PROGRESS
  COMPLETED_CLIENT
  FAILED
  CANCELLED
  UNKNOWN
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  CLOSED
}

enum SyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  authId          String          @unique @map("auth_id")
  name            String          @db.VarChar(120)
  email           String          @unique @db.VarChar(254)
  status          UserStatus      @default(INVITED)
  lastLoginAt     DateTime?       @map("last_login_at") @db.Timestamptz(3)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles           UserRole[]
  transferBatches TransferBatch[]
  downloadEvents  DownloadEvent[]
  auditLogs       AuditLog[]      @relation("AuditActor")

  @@index([status])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(60)
  name        String           @db.VarChar(80)
  description String?          @db.VarChar(255)
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(80)
  description String           @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model DriveAccount {
  id                    String             @id @default(uuid()) @db.Uuid
  email                 String             @unique @db.VarChar(254)
  displayName           String?            @map("display_name") @db.VarChar(120)
  status                DriveAccountStatus @default(PENDING)
  tokenEncrypted        String?            @map("token_encrypted") @db.Text
  refreshTokenEncrypted String?            @map("refresh_token_encrypted") @db.Text
  tokenExpiresAt        DateTime?          @map("token_expires_at") @db.Timestamptz(3)
  lastSyncedAt          DateTime?          @map("last_synced_at") @db.Timestamptz(3)
  lastError             String?            @map("last_error") @db.VarChar(500)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  folders               DriveFolder[]
  videos                Video[]
  syncRuns              SyncRun[]
  transferBatches       TransferBatch[]

  @@map("drive_accounts")
}

model DriveFolder {
  id            String       @id @default(uuid()) @db.Uuid
  accountId     String       @map("account_id") @db.Uuid
  driveFolderId String       @map("drive_folder_id") @db.VarChar(255)
  name          String       @db.VarChar(255)
  syncEnabled   Boolean      @default(true) @map("sync_enabled")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  account       DriveAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  videos        Video[]

  @@unique([accountId, driveFolderId])
  @@map("drive_folders")
}

model Video {
  id              String       @id @default(uuid()) @db.Uuid
  accountId       String       @map("account_id") @db.Uuid
  folderId        String?      @map("folder_id") @db.Uuid
  driveFileId     String       @map("drive_file_id") @db.VarChar(255)
  name            String       @db.VarChar(255)
  sizeBytes       BigInt       @map("size_bytes")
  mimeType        String       @map("mime_type") @db.VarChar(150)
  checksum        String?      @db.VarChar(255)
  thumbnailUrl    String?      @map("thumbnail_url") @db.Text
  durationSeconds Int?         @map("duration_seconds")
  driveModifiedAt DateTime     @map("drive_modified_at") @db.Timestamptz(3)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  account         DriveAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  folder          DriveFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags            VideoTag[]
  transfers       Transfer[]

  @@unique([accountId, driveFileId])
  @@index([name])
  @@index([driveModifiedAt])
  @@map("videos")
}

model Tag {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique @db.VarChar(60)
  color     String     @default("#2563eb") @db.VarChar(20)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  videos    VideoTag[]

  @@map("tags")
}

model VideoTag {
  videoId String @map("video_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
  @@map("video_tags")
}

model TransferBatch {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  accountId      String?        @map("account_id") @db.Uuid
  type           TransferType
  status         TransferStatus @default(PENDING)
  idempotencyKey String         @map("idempotency_key") @db.VarChar(120)
  totalFiles     Int            @default(0) @map("total_files")
  totalBytes     BigInt         @default(0) @map("total_bytes")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  account        DriveAccount?  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transfers      Transfer[]

  @@unique([userId, idempotencyKey])
  @@index([type, status])
  @@map("transfer_batches")
}

model Transfer {
  id                        String          @id @default(uuid()) @db.Uuid
  batchId                   String          @map("batch_id") @db.Uuid
  videoId                   String?         @map("video_id") @db.Uuid
  status                    TransferStatus  @default(PENDING)
  fileNameSnapshot          String          @map("file_name_snapshot") @db.VarChar(255)
  fileSizeSnapshot          BigInt          @map("file_size_snapshot")
  sourceSnapshot            String          @map("source_snapshot") @db.VarChar(255)
  mimeTypeSnapshot          String          @map("mime_type_snapshot") @db.VarChar(150)
  bytesTransferred          BigInt          @default(0) @map("bytes_transferred")
  attemptCount              Int             @default(0) @map("attempt_count")
  clientFileId              String?         @map("client_file_id") @db.VarChar(100)
  resumableSessionEncrypted String?         @map("resumable_session_encrypted") @db.Text
  errorCode                 String?         @map("error_code") @db.VarChar(80)
  errorMessage              String?         @map("error_message") @db.VarChar(500)
  startedAt                 DateTime?       @map("started_at") @db.Timestamptz(3)
  finishedAt                DateTime?       @map("finished_at") @db.Timestamptz(3)
  createdAt                 DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  batch                     TransferBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  video                     Video?          @relation(fields: [videoId], references: [id], onDelete: SetNull)
  events                    DownloadEvent[]

  @@index([status])
  @@index([videoId])
  @@map("transfers")
}

model DownloadEvent {
  id               String         @id @default(uuid()) @db.Uuid
  transferId       String         @map("transfer_id") @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  eventType        TransferStatus @map("event_type")
  bytesTransferred BigInt?        @map("bytes_transferred")
  errorCode        String?        @map("error_code") @db.VarChar(80)
  errorMessage     String?        @map("error_message") @db.VarChar(500)
  occurredAt       DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  correlationId    String         @map("correlation_id") @db.VarChar(80)
  transfer         Transfer       @relation(fields: [transferId], references: [id], onDelete: Restrict)
  user             User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([userId, occurredAt])
  @@map("download_events")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String   @db.VarChar(100)
  resourceType  String   @map("resource_type") @db.VarChar(80)
  resourceId    String?  @map("resource_id") @db.VarChar(100)
  before        Json?
  after         Json?
  ipAddress     String?  @map("ip_address") @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  correlationId String   @map("correlation_id") @db.VarChar(80)
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model SyncRun {
  id           String       @id @default(uuid()) @db.Uuid
  accountId    String       @map("account_id") @db.Uuid
  status       SyncStatus   @default(PENDING)
  filesFound   Int          @default(0) @map("files_found")
  filesCreated Int          @default(0) @map("files_created")
  filesUpdated Int          @default(0) @map("files_updated")
  filesRemoved Int          @default(0) @map("files_removed")
  errorMessage String?      @map("error_message") @db.VarChar(500)
  startedAt    DateTime?    @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?    @map("finished_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  account      DriveAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@map("sync_runs")
}

model Campaign {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @db.VarChar(120)
  startsAt  DateTime       @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime       @map("ends_at") @db.Timestamptz(3)
  timezone  String         @default("America/Sao_Paulo") @db.VarChar(80)
  status    CampaignStatus @default(DRAFT)
  closedAt  DateTime?      @map("closed_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("campaigns")
}
